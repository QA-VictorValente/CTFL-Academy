# ==========================================================
# CTFL ACADEMY — CONFIGURAÇÃO DE AMBIENTE (.env.example)
# ==========================================================

# Banco de Dados PostgreSQL (Docker Compose ou Instância Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ctfl_academy?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ctfl_academy?schema=public"

# Autenticação Supabase Auth
# Para usar um projeto Supabase Cloud ou Supabase CLI local, preencha as chaves abaixo
# e defina SUPABASE_LOCAL_AUTH="false".
# Para execução 100% local compatível sem dependência externa, mantenha SUPABASE_LOCAL_AUTH="true".
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"
SUPABASE_LOCAL_AUTH="true"

# Segredo criptográfico para assinatura de sessão HMAC-SHA256 no modo local compatível
# Gere um valor seguro com: openssl rand -hex 32
AUTH_SECRET="change-this-secret-in-production-at-least-32-chars-long"

# URL pública da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
